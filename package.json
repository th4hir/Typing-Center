{
  "name": "typing-center",
  "version": "1.0.0",
  "description": "Typing Center Desktop Application",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "package": "electron-vite build && electron-builder"
  },
  "keywords": [],
  "author": "First Choice Software GmbH",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^42.4.1",
    "electron-vite": "^5.0.0",
    "prisma": "^5.22.0",
    "vite": "^7.3.5",
    "electron-builder": "^24.13.3"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@prisma/client": "^5.22.0",
    "ag-grid-community": "^35.3.1",
    "ag-grid-react": "^35.3.1",
    "bootstrap": "^5.3.8",
    "react": "^19.2.7",
    "react-bootstrap": "^2.10.10",
    "react-dom": "^19.2.7"
  },
  "build": {
    "appId": "com.FirstChoice_Typing.app",
    "productName": "Typing Center",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "package.json",
      "prisma/**/*"
    ],
    "asar": false,
    "extraResources": [
      {
        "from": "node_modules/.prisma",
        "to": "app/node_modules/.prisma"
      },
      {
        "from": "node_modules/@prisma/engines",
        "to": "app/node_modules/@prisma/engines"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "src/logo_256.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "First Choice Typing",
      "installerHeader": "src/installerHeader.bmp",
      "installerSidebar": "src/installerSidebar.bmp"
    }
  }
}