generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Single-row table: this shop's identity
model ShopConfig {
  id        Int    @id @default(1)
  shopName  String @default("Typing Center")
  address   String @default("")
  phone     String @default("")
}

model Category {
  id       Int       @id @default(autoincrement())
  name     String    @unique
  services Service[]
}

model Service {
  id           Int           @id @default(autoincrement())
  name         String
  price        Float
  categoryId   Int
  category     Category      @relation(fields: [categoryId], references: [id])
  applications Application[]
}

// Bank cards the typing center uses for payments
model PaymentCard {
  id        Int     @id @default(autoincrement())
  bankName  String  @unique
  isActive  Boolean @default(true)
}

// Companies that use the typing center
model Company {
  id    Int    @id @default(autoincrement())
  name  String @unique
}

model Application {
  id              Int      @id @default(autoincrement())
  customerName    String
  phone           String   @default("")
  emiratesId      String   @default("")
  customerType    String   @default("Individual")
  status          String   @default("Pending")
  createdAt       DateTime @default(now())

  serviceId       Int
  service         Service  @relation(fields: [serviceId], references: [id])

  // Money IN — what customer pays us
  serviceCharge   Float    @default(0)
  customerPayment String   @default("Cash")

  // Money OUT — what we pay government/entity
  govtFee         Float    @default(0)
  govtPayment     String   @default("Cash")

  // Our fee (serviceCharge - govtFee)
  typingFee       Float    @default(0)
}
