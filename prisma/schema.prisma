generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Single-row table: this shop's identity
model ShopConfig {
  id        Int    @id @default(1)
  shopName  String @default("Typing Center")
  address   String @default("")
  phone     String @default("")
}

model Category {
  id       Int       @id @default(autoincrement())
  name     String    @unique
  isTravel Boolean   @default(false)
  services Service[]
}

model Service {
  id           Int           @id @default(autoincrement())
  name         String
  price        Float
  categoryId   Int
  category     Category      @relation(fields: [categoryId], references: [id])
  applications Application[]
}

// Bank cards the typing center uses for payments
model PaymentCard {
  id         Int     @id @default(autoincrement())
  bankName   String  @unique
  isActive   Boolean @default(true)
  isPersonal Boolean @default(false)
}

// Companies that use the typing center
model Company {
  id             Int             @id @default(autoincrement())
  name           String          @unique
  advanceBalance Float           @default(0)
  records        CompanyRecord[]
}

model CompanyRecord {
  id             Int       @id @default(autoincrement())
  companyId      Int
  company        Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  category       String    // e.g. "Trade License", "Health Insurance", "Visa", "Other Documents"
  employeeName   String    @default("")
  documentNumber String    @default("")
  documentType   String    @default("")
  issueDate      DateTime?
  expiryDate     DateTime?
  status         String    @default("Active")
  notes          String    @default("")
  createdAt      DateTime  @default(now())
}

// Individuals who use the typing center for personal services (Visa, Emirates ID, Insurance, etc.)
model Individual {
  id             Int                @id @default(autoincrement())
  name           String             @unique
  phone          String             @default("")
  advanceBalance Float                @default(0)
  records        IndividualRecord[]
}

model IndividualRecord {
  id             Int        @id @default(autoincrement())
  individualId   Int
  individual     Individual @relation(fields: [individualId], references: [id], onDelete: Cascade)
  category       String     // e.g. "Visa", "Health Insurance", "Emirates ID", "Other Documents"
  holderName     String     @default("") // Name of applicant (Self or family member/dependent)
  documentNumber String     @default("")
  documentType   String     @default("")
  issueDate      DateTime?
  expiryDate     DateTime?
  status         String     @default("Active")
  notes          String     @default("")
  createdAt      DateTime   @default(now())
}


model Application {
  id              Int      @id @default(autoincrement())
  customerName    String
  phone           String   @default("")
  emiratesId      String   @default("")
  customerType    String   @default("Individual")
  status          String   @default("Pending")
  createdAt       DateTime @default(now())
  createdBy       String   @default("") // staff username who created it

  serviceId       Int
  service         Service  @relation(fields: [serviceId], references: [id])

  // Money IN — what customer pays us
  serviceCharge   Float    @default(0)
  customerPayment String   @default("Cash")
  paidAmount      Float    @default(0)
  balance         Float    @default(0)
  cardReceiptNet  Float?   @default(0)
  receivingAccount String?
  settlementNote   String?  @default("")

  // Money OUT — what we pay government/entity
  govtFee         Float    @default(0)
  govtPayment     String   @default("Cash")
  govtEntity      String   @default("")
  govtPaid        Float    @default(0)

  // Our fee (serviceCharge - govtFee)
  typingFee       Float    @default(0)
}

model User {
  id        Int     @id @default(autoincrement())
  username  String  @unique
  password  String           // hashed or plain (depending on hashing preference)
  fullName  String
  role      String  @default("Staff")  // "Admin" or "Staff"
  isActive  Boolean @default(true)
}

model Expense {
  id            Int      @id @default(autoincrement())
  description   String
  amount        Float
  paymentMethod String   @default("Cash")
  createdAt     DateTime @default(now())
}

model GovtEntity {
  id   Int    @id @default(autoincrement())
  name String @unique
}

model GovtEntityPayment {
  id            Int      @id @default(autoincrement())
  entityName    String
  amount        Float
  paymentMethod String   @default("Cash")
  notes         String   @default("")
  createdAt     DateTime @default(now())
}

model TravelSupplier {
  id   Int    @id @default(autoincrement())
  name String @unique
}

model TravelSupplierPayment {
  id            Int      @id @default(autoincrement())
  supplierName  String
  amount        Float
  paymentMethod String   @default("Cash")
  notes         String   @default("")
  createdAt     DateTime @default(now())
}

model AccountTransfer {
  id          Int      @id @default(autoincrement())
  fromAccount String
  toAccount   String
  amount      Float
  notes       String   @default("")
  createdAt   DateTime @default(now())
}


